# Local `act` configuration. The ubuntu-24.04 image mapping every job here
# needs is a per-machine choice, so it stays out of the repo:
#   -P ubuntu-24.04=catthehacker/ubuntu:act-latest
.actrc

# Local docker-compose port overrides (per-machine, not shared)
docker-compose.override.yml

# Module Federation build scratch. The plugin writes diagnostics here on every
# build of the remote and of any host that consumes it.
.mf/

# Cypress code coverage output, written by @cypress/code-coverage on a component
# run. Uploaded to Codecov from CI; never committed.
coverage/
cypress/screenshots/
cypress/videos/
.nyc_output/
