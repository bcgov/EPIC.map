FLASK_ENV=development
export FLASK_APP=wsgi.py

# local db variables
DATABASE_USERNAME=map
DATABASE_PASSWORD=map
DATABASE_NAME=map-db
DATABASE_HOST=localhost
DATABASE_PORT=54332

DATABASE_TEST_USERNAME=map
DATABASE_TEST_PASSWORD=map
DATABASE_TEST_NAME=map-db
DATABASE_TEST_HOST=localhost
DATABASE_TEST_PORT=54333

# local redis (see map-redis in docker-compose.yml)
REDIS_URL=redis://localhost:6379/0

JWT_OIDC_TEST_ISSUER="http://localhost:8081/auth/realms/demo"
JWT_OIDC_TEST_WELL_KNOWN_CONFIG="http://localhost:8081/auth/realms/demo/.well-known/openid-configuration"
JWT_OIDC_TEST_ALGORITHMS="RS256"
JWT_OIDC_TEST_AUDIENCE="map-web"
JWT_OIDC_TEST_CLIENT_SECRET="1111111111"
JWT_OIDC_TEST_JWKS_CACHE_TIMEOUT="6000"

JWT_OIDC_WELL_KNOWN_CONFIG=https://dev.loginproxy.gov.bc.ca/auth/realms/eao-epic/.well-known/openid-configuration
# Fallback for ALLOWED_CLIENT_IDS below; no longer the audience check itself.
JWT_OIDC_AUDIENCE=account
JWT_OIDC_ISSUER=https://dev.loginproxy.gov.bc.ca/auth/realms/eao-epic
JWT_OIDC_ALGORITHMS=RS256
JWT_OIDC_JWKS_URI=https://dev.loginproxy.gov.bc.ca/auth/realms/eao-epic/protocol/openid-connect/certs
JWT_OIDC_CACHING_ENABLED=True
JWT_OIDC_JWKS_CACHE_TIMEOUT=3000000
# The keycloak client this API's own tokens are issued to. No longer a source of
# authorization - see ALLOWED_CLIENT_IDS.
JWT_OIDC_CLIENT_ID=epic-map

# The keycloak clients whose tokens this API accepts, comma separated. Every
# EPIC application that embeds the map has its own client in the shared eao-epic
# realm, and a token names its client in azp (and sometimes in aud), so a single
# audience can no longer describe who may call. Signature, issuer and expiry are
# unaffected; this is only the audience decision.
#
# List every environment's host applications here. When the SSO team adds a
# dedicated scope for this API this collapses to one entry
# (ALLOWED_CLIENT_IDS=epic-map-api) and nothing in the code changes.
ALLOWED_CLIENT_IDS=compliance-web,submit-web,track-web,map-web

# The keycloak group a token must carry to reach this API. Leave empty until the
# realm has a group for EPIC.map: while it is empty, any valid IDIR token from
# the shared eao-epic realm is accepted - including staff who only work in the
# other EPIC applications. Set it to MAP once that group exists.
AUTH_REQUIRED_GROUP=

SITE_URL=http://localhost:3000
KEYCLOAK_BASE_URL=https://dev.loginproxy.gov.bc.ca
KEYCLOAK_URL_REALM=eao-epic

MAP_ADMIN_CLIENT_ID=map-admin
MAP_ADMIN_CLIENT_SECRET=<GENERATED_CLIENT_SECRET>

# Browser origins allowed to call this API, comma separated. One list per
# environment, naming every EPIC application that embeds the map - not just
# map-web. Credentialed CORS is deliberately off: callers send a bearer token in
# the Authorization header, never a cookie.
#
# Unset in development/docker/testing, the API falls back to LOCAL_CORS_ORIGINS
# in config.py. A deployed environment must set this or no browser can call it.
CORS_ORIGIN=http://192.168.0.145:8000,http://192.168.0.145:3000,http://localhost:8000,http://localhost:3000,http://localhost:5000,http://localhost:5173

S3_BUCKET=<BUCKET_NAME>
S3_ACCESS_KEY_ID=map-admin
S3_SECRET_ACCESS_KEY=<GENERATED_S3_SECRET>
S3_HOST=
S3_REGION=
S3_SERVICE=