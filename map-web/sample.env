# Base URL of map-api, including the /api prefix.
VITE_API_URL=http://localhost:5000/api
# Where this app is served from. The OIDC redirect URIs are derived from it, so
# it must match the dev server's address (Vite's default port is 5173).
VITE_APP_URL=http://localhost:5173
VITE_APP_TITLE=EPIC.map
VITE_ENV=local
VITE_VERSION=

VITE_OIDC_AUTHORITY=https://dev.loginproxy.gov.bc.ca/auth/realms/eao-epic
VITE_CLIENT_ID=epic-map

# Origin serving the map's Module Federation remote, without a trailing path.
# The map is fetched from here at runtime rather than bundled into this app.
# `npm run dev` at the repository root starts the widget on 5174, which is also
# the default when this is unset.
VITE_MAP_WIDGET_URL=http://127.0.0.1:5174
