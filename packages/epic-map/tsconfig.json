{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* "@/..." means "from the root of this package's src". Three places have to
       agree for it to work, and all three are load-bearing:
         - here, so `tsc --noEmit` resolves it;
         - `vite.config.ts` resolve.alias, so the library build resolves it and
           vite-plugin-dts rewrites it back to a relative path in the emitted
           .d.ts (consumers have no such alias);
         - `map-web/vite.config.ts`, whose own "@" points at the *host's* src —
           it needs an importer-aware entry for EPIC_MAP_SOURCE=1 mode. */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Bundler mode */
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
