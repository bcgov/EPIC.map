{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* "@/..." means "from the root of this package's src". Two places have to
       agree for it to work: here, so `tsc --noEmit` resolves it, and
       `vite.config.ts` resolve.alias, so the build does. It used to be three -
       map-web compiled this source in its own module graph and had to resolve
       "@/" against whichever tree the importing file came from. It does not
       compile any of this any more. */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Bundler mode */
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "tests"]
}
